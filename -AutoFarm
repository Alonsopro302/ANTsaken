local function ActivatePcMode()
    if PcModeActive then return end
    PcModeActive = true
    
    local function SimulateKeyPress(key)
        local keyCode = Enum.KeyCode[key]
        if keyCode then
            ContextActionService:BindAction("PcMode_" .. key, function(actionName, inputState, inputObject)
                if inputState == Enum.UserInputState.Begin then
                    return Enum.ContextActionResult.Sink
                end
                return Enum.ContextActionResult.Pass
            end, false, keyCode)
            task.wait(0.05)
            ContextActionService:UnbindAction("PcMode_" .. key)
        end
    end
    
    pcall(function()
        SimulateKeyPress("Q")
        task.wait(0.1)
        SimulateKeyPress("Q")
        
        local playerGui = LocalPlayer.PlayerGui
        if playerGui then
            for _, gui in ipairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    for _, child in ipairs(gui:GetDescendants()) do
                        if child:IsA("TextButton") or child:IsA("ImageButton") then
                            local text = child.Text or child.Name or ""
                            if text:lower():find("pc") or text:lower():find("keyboard") or 
                               text:lower():find("modo") or text:lower():find("mobile") then
                                child:FireServer()
                                fireclickdetector(child)
                                return
                            end
                        end
                    end
                end
            end
        end
        
        local remoteEvent = ReplicatedStorage:FindFirstChild("Modules")
        if remoteEvent then
            local network = remoteEvent:FindFirstChild("Network")
            if network then
                local remote = network:FindFirstChild("RemoteEvent")
                if remote then
                    remote:FireServer("SetControlMode", "PC")
                end
            end
        end
    end)
end

local function GetAdvancedServers()
    local servers = {}
    local cursor = ""
    local attempts = 0
    
    while attempts < 3 do
        attempts = attempts + 1
        local url = string.format(
            "https://games.roblox.com/v1/games/18687417158/servers/Public?sortOrder=Asc&limit=100&excludeFullServers=true&cursor=%s",
            cursor
        )
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                local quality = 100
                
                if server.playing <= Config.MinPlayers then
                    quality = quality + 30
                elseif server.playing <= Config.MaxPlayers then
                    quality = quality + 10
                elseif server.playing > Config.MaxPlayers + 5 then
                    quality = quality - 20
                end
                
                if server.playing > 0 and server.playing < server.maxPlayers then
                    quality = quality + 15
                end
                
                if Config.PreferNewServer then
                    quality = quality + 5
                end
                
                if u15[server.id] then
                    quality = quality - 50
                end
                
                local isRecent = false
                for _, id in ipairs(v9) do
                    if id == server.id then isRecent = true break end
                end
                if isRecent then quality = quality - 30 end
                
                servers[server.id] = {
                    id = server.id,
                    playing = server.playing,
                    maxPlayers = server.maxPlayers,
                    quality = math.max(0, math.min(100, quality)),
                    region = server.region,
                    ping = server.ping or 0,
                }
            end
            
            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            task.wait(0.5)
        end
    end
    
    local serverList = {}
    for id, server in pairs(servers) do
        if id ~= game.JobId then
            table.insert(serverList, server)
        end
    end
    
    table.sort(serverList, function(a, b)
        return a.quality > b.quality
    end)
    
    return serverList
end

function ServerHop()
    if Stats.HopsThisHour >= Config.MaxHopsPerHour then
        task.wait(60)
        Stats.HopsThisHour = 0
        return
    end
    
    Stats.Hops = Stats.Hops + 1
    Stats.HopsThisHour = Stats.HopsThisHour + 1
    Stats.LastHopTime = os.time()
    
    pcall(function()
        if getgenv then
            getgenv().AntsakenAutoExec = true
            getgenv().AntsakenConfig = Config
            getgenv().AntsakenStats = Stats
        end
    end)
    
    local servers = GetAdvancedServers()
    
    if #servers == 0 then
        task.delay(5, ServerHop)
        return
    end
    
    local bestServer = servers[1]
    
    if bestServer.quality < 30 then
        task.wait(10)
        ServerHop()
        return
    end
    
    u13 = bestServer.id
    table.insert(v9, bestServer.id)
    if #v9 > 10 then table.remove(v9, 1) end
    pcall(function() getgenv().AntsakenRecentServers = v9 end)
    
    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(18687417158, bestServer.id, LocalPlayer)
    end)
    
    if not success then
        u15[bestServer.id] = true
        pcall(function() getgenv().AntsakenBadServers = u15 end)
        task.delay(3, ServerHop)
    end
end

local function GetKillerAttackAbility()
    if not LocalPlayer.Character then return "Slash" end
    local charName = LocalPlayer.Character.Name
    if charName == "Noli" then return "Stab" end
    if charName == "c001kidd" then return "Punch" end
    if charName == "1x1x1x1" then return "Slash" end
    if charName == "Slasher" then return "Slash" end
    if charName == "Guest1337" then return "Punch" end
    return "Slash"
end

local function GetAliveSurvivors()
    local survivors = {}
    local playersContainer = workspace:FindFirstChild("Players")
    if not playersContainer then return survivors end
    
    local survivorsGroup = playersContainer:FindFirstChild("Survivors")
    if not survivorsGroup then return survivors end
    
    for _, child in ipairs(survivorsGroup:GetChildren()) do
        if child:IsA("Model") then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = child:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local localChar = LocalPlayer.Character
                    local distance = 999
                    if localChar and localChar.PrimaryPart then
                        distance = (rootPart.Position - localChar.PrimaryPart.Position).Magnitude
                    end
                    table.insert(survivors, {
                        Model = child,
                        Humanoid = humanoid,
                        RootPart = rootPart,
                        Distance = distance,
                    })
                end
            end
        end
    end
    
    table.sort(survivors, function(a, b) return a.Distance < b.Distance end)
    return survivors
end

local function CheckIsKiller()
    local playersContainer = workspace:FindFirstChild("Players")
    if not playersContainer then return false end
    
    local killersGroup = playersContainer:FindFirstChild("Killers")
    if not killersGroup then return false end
    
    for _, child in ipairs(killersGroup:GetChildren()) do
        if child:IsA("Model") and child:GetAttribute("Username") == LocalPlayer.Name then
            return true
        end
    end
    return false
end

local function AttackSurvivor()
    local currentTime = os.clock()
    if currentTime - lastAttackTime < Config.KillAllCooldown then return false end
    
    local success = false
    
    if PcModeActive then
        local function PressKey(key)
            ContextActionService:BindAction("Attack_" .. key, function(actionName, inputState, inputObject)
                if inputState == Enum.UserInputState.Begin then
                    return Enum.ContextActionResult.Sink
                end
                return Enum.ContextActionResult.Pass
            end, false, Enum.KeyCode[key])
            task.wait(0.05)
            ContextActionService:UnbindAction("Attack_" .. key)
        end
        
        local attackKeys = {"R", "F", "E", "Q", "MouseButton1"}
        for _, key in ipairs(attackKeys) do
            pcall(function()
                if key == "MouseButton1" then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new())
                else
                    PressKey(key)
                end
                success = true
            end)
            if success then break end
        end
    end
    
    if not success then
        pcall(function()
            local remoteEvent = ReplicatedStorage:FindFirstChild("Modules")
            if remoteEvent then
                local network = remoteEvent:FindFirstChild("Network")
                if network then
                    local remote = network:FindFirstChild("RemoteEvent")
                    if remote then
                        remote:FireServer("UseActorAbility", GetKillerAttackAbility())
                        success = true
                    end
                end
            end
        end)
    end
    
    if not success then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new())
            success = true
        end)
    end
    
    if success then
        lastAttackTime = currentTime
        Stats.Kills = Stats.Kills + 1
    end
    
    return success
end

local function TeleportBehindSurvivor(target)
    if not target or not target.RootPart then return false end
    if not LocalPlayer.Character then return false end
    
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local lookVector = target.RootPart.CFrame.LookVector
    local behindPos = target.RootPart.Position - lookVector * 2.7 + Vector3.new(0, 1.5, 0)
    
    rootPart.CFrame = CFrame.new(behindPos, target.RootPart.Position)
    return true
end

local function FlyToSurvivor(target)
    if not target or not target.RootPart then return false end
    if not LocalPlayer.Character then return false end
    
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local direction = (target.RootPart.Position - rootPart.Position).Unit
    local moveToPos = rootPart.Position + direction * 15
    
    humanoid:MoveTo(moveToPos)
    return true
end

local function KillAllLoop()
    if killAllConnection then
        killAllConnection:Disconnect()
        killAllConnection = nil
    end
    
    ActivatePcMode()
    
    killAllConnection = RunService.Heartbeat:Connect(function()
        if not Config.KillAll then
            if killAllConnection then
                killAllConnection:Disconnect()
                killAllConnection = nil
            end
            return
        end
        
        if not CheckIsKiller() then
            isKiller = false
            return
        end
        isKiller = true
        
        if currentTarget then
            if not currentTarget.Model or not currentTarget.Model.Parent then
                currentTarget = nil
            elseif currentTarget.Humanoid and currentTarget.Humanoid.Health <= 0 then
                currentTarget = nil
            end
        end
        
        if not currentTarget then
            local survivors = GetAliveSurvivors()
            if #survivors > 0 then
                currentTarget = survivors[1]
            else
                return
            end
        end
        
        if Config.KillAllTeleport then
            TeleportBehindSurvivor(currentTarget)
            task.wait(0.05)
        elseif Config.KillAllFly then
            FlyToSurvivor(currentTarget)
        end
        
        if currentTarget and currentTarget.RootPart then
            local localChar = LocalPlayer.Character
            if localChar and localChar.PrimaryPart then
                local distance = (currentTarget.RootPart.Position - localChar.PrimaryPart.Position).Magnitude
                if distance < Config.AuraRange then
                    AttackSurvivor()
                end
            end
        end
    end)
end

local function GetGenerators()
    local gens = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        local ingame = map:FindFirstChild("Ingame")
        if ingame then
            local map2 = ingame:FindFirstChild("Map")
            if map2 then
                for _, child in ipairs(map2:GetChildren()) do
                    if child.Name == "Generator" and child:IsA("Model") then
                        local progress = child:FindFirstChild("Progress")
                        local remotes = child:FindFirstChild("Remotes")
                        if progress and remotes and child.PrimaryPart then
                            local position = nil
                            local main = child:FindFirstChild("Main")
                            local positions = child:FindFirstChild("Positions")
                            if positions then
                                local center = positions:FindFirstChild("Center")
                                if center then position = center.Position end
                            end
                            if not position and main then
                                local prompt = main:FindFirstChild("Prompt")
                                if prompt and prompt:IsA("ProximityPrompt") then
                                    local attachment = prompt:FindFirstChildOfClass("Attachment")
                                    if attachment then position = attachment.WorldCFrame.Position end
                                end
                            end
                            if not position and main then
                                for _, part in ipairs(main:GetChildren()) do
                                    if part:IsA("BasePart") then
                                        position = part.Position + Vector3.new(0, 3, 0)
                                        break
                                    end
                                end
                            end
                            if not position then
                                position = child.PrimaryPart.Position + Vector3.new(0, 5, 0)
                            end
                            table.insert(gens, {
                                Model = child,
                                Progress = progress,
                                RF = remotes:FindFirstChild("RF"),
                                RE = remotes:FindFirstChild("RE"),
                                Prompt = main and main:FindFirstChild("Prompt"),
                                Position = position,
                                GenPosition = child.PrimaryPart.Position,
                            })
                        end
                    end
                end
            end
        end
    end
    return gens
end

local function FixGenerator(gen)
    if not gen.Model or not gen.Model.Parent then return false end
    if gen.Progress.Value >= 100 then return true end
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    rootPart.CFrame = CFrame.new(gen.Position + Vector3.new(0, 2, 0))
    task.wait(0.25)
    pcall(function() gen.RF:InvokeServer("Enter") end)
    task.wait(0.15)
    pcall(function() gen.RE:FireServer() end)
    task.wait(0.15)
    task.spawn(function() pcall(function() gen.RF:InvokeServer("Leave") end) end)
    isWaiting = false
    elapsed = os.clock()
    return true
end

local function AutoSwitchSurvivor()
    if not Config.AutoSwitchSurvivor then return end
    pcall(function()
        local DataHandler = require(ReplicatedStorage.Modules.Data.DataHandler)
        local Network = require(ReplicatedStorage.Modules.Network.Network)
        local data = DataHandler:Get()
        if not data then return end
        local survivors = {}
        for _, child in ipairs(data.Purchased.Survivors:GetChildren()) do
            if child:IsA("IntValue") or child:IsA("NumberValue") then
                local asset = ReplicatedStorage.Assets.Survivors:FindFirstChild(child.Name)
                if asset then
                    local level = math.floor((math.sqrt(child.Value * 20 + 11225) - 95) / 10)
                    table.insert(survivors, {
                        Name = child.Name,
                        XP = child.Value,
                        Level = math.min(level, 100),
                        Asset = asset
                    })
                end
            end
        end
        if #survivors > 0 then
            table.sort(survivors, function(a, b) return a.Level > b.Level end)
            local target = nil
            for _, v in ipairs(survivors) do
                if v.Level < 100 then
                    target = v
                    break
                end
            end
            if not target then target = survivors[#survivors] end
            if target and data.Equipped.Survivor.Value ~= target.Name then
                Network:FireServerConnection("EquipState", "REMOTE_EVENT", target.Asset, true)
            end
        end
    end)
end

local function StartFarm()
    if isFarming then return end
    isFarming = true
    Stats.Fixed = 0
    Stats.StartTime = os.clock()
    if Config.AutoSwitchSurvivor then task.spawn(AutoSwitchSurvivor) end
    elapsed = os.clock()
    local stallCount = 0

    task.spawn(function()
        while isFarming do
            if not isWaiting then
                elapsed = os.clock()
                stallCount = 0
            elseif os.clock() - elapsed > 30 then
                stallCount = stallCount + 1
                elapsed = os.clock()
                if stallCount >= 3 then
                    isFarming = false
                    task.wait(0.5)
                    ServerHop()
                    return
                end
            end
            task.wait(0.5)
        end
    end)

    local deathConnection = nil
    while isFarming do
        local character = LocalPlayer.Character
        if character and character.Parent then
            local parentName = character.Parent.Name
            if parentName == "Survivors" or parentName == "Killers" then
                if not deathConnection then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        deathConnection = humanoid.Died:Connect(function()
                            if isFarming then
                                isFarming = false
                                task.wait(1)
                                ServerHop()
                            end
                        end)
                    end
                end
                local gens = GetGenerators()
                local totalGens = #gens
                local doneGens = 0
                local availableGens = {}
                for _, gen in ipairs(gens) do
                    if gen.Progress.Value >= 100 then doneGens = doneGens + 1 else table.insert(availableGens, gen) end
                end
                if totalGens > 0 and doneGens >= Config.TargetGens then
                    isFarming = false
                    task.wait(0.5)
                    ServerHop()
                    break
                end
                if #availableGens > 0 then
                    for _, gen in ipairs(availableGens) do
                        if not isFarming then break end
                        local character2 = LocalPlayer.Character
                        if not character2 or not character2.Parent then break end
                        if gen.Progress.Value < 100 and gen.Model and gen.Model.Parent then
                            if FixGenerator(gen) then Stats.Fixed = Stats.Fixed + 1 end
                        end
                    end
                else
                    task.wait(0.3)
                end
            else
                if deathConnection then deathConnection:Disconnect(); deathConnection = nil end
                task.wait(1)
            end
        else
            if deathConnection then deathConnection:Disconnect(); deathConnection = nil end
            task.wait(1)
        end
    end
    if deathConnection then deathConnection:Disconnect() end
end

local hiddenGuis = {}
local hiddenProperties = {}
local stealthConnection = nil
local walkSpeed = nil
local maxSlopeAngle = nil

function EnableStealth()
    Config.Stealth = true
    local character = LocalPlayer.Character
    if not character then return end
    pcall(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            hiddenProperties.health = humanoid.HealthDisplayType
            hiddenProperties.name = humanoid.DisplayDistanceType
            humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
            walkSpeed = humanoid.WalkSpeed
            maxSlopeAngle = humanoid.MaxSlopeAngle
            humanoid.WalkSpeed = 16
            humanoid.MaxSlopeAngle = 45
        end
        local function hideGui(instance)
            if instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
                if instance.Enabled then
                    table.insert(hiddenGuis, instance)
                    instance.Enabled = false
                end
            end
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                for _, child in ipairs(part:GetChildren()) do hideGui(child) end
            end
        end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then hideGui(child) end
        end
    end)
    pcall(function()
        setsimulationradius(0)
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 0)
        end
    end)
    if stealthConnection then stealthConnection:Disconnect() end
    stealthConnection = RunService.Heartbeat:Connect(function()
        if Config.Stealth then pcall(function() setsimulationradius(0) end) end
    end)
end

function DisableStealth()
    Config.Stealth = false
    pcall(function()
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if hiddenProperties.health then humanoid.HealthDisplayType = hiddenProperties.health end
                if hiddenProperties.name then humanoid.DisplayDistanceType = hiddenProperties.name end
                if walkSpeed then humanoid.WalkSpeed = walkSpeed end
                if maxSlopeAngle then humanoid.MaxSlopeAngle = maxSlopeAngle end
            end
        end
        for _, gui in ipairs(hiddenGuis) do
            if gui and gui.Parent then gui.Enabled = true end
        end
        hiddenGuis = {}
        hiddenProperties = {}
    end)
    pcall(function()
        setsimulationradius(2048)
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 2048)
        end
    end)
    if stealthConnection then
        stealthConnection:Disconnect()
        stealthConnection = nil
    end
end

